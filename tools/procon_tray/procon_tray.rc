// Ícone e informações de versão do ProconWin (aparecem nas propriedades do .exe).
#include <winver.h>

#include "version.h"

1 ICON "res/proconwin.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION PROCONWIN_VERSION_RC
PRODUCTVERSION PROCONWIN_VERSION_RC
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041604B0"
    BEGIN
      VALUE "CompanyName", "ProconWin"
      VALUE "FileDescription", "ProconWin"
      VALUE "FileVersion", PROCONWIN_VERSION
      VALUE "ProductName", "ProconWin"
      VALUE "ProductVersion", PROCONWIN_VERSION
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "procon_tray.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0416, 1200
  END
END
