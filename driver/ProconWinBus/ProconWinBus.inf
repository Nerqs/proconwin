[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%ManufacturerName%
CatalogFile=ProconWinBus.cat
DriverVer= ;
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksFiles]
ProconWinBus.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$.10.0...16299

[Standard.NT$ARCH$.10.0...16299]
%ProconWinBus.DeviceDesc%=ProconWinBus_Device, Root\ProconWinBus

[ProconWinBus_Device.NT]
CopyFiles=Drivers_Dir

[Drivers_Dir]
ProconWinBus.sys

[ProconWinBus_Device.NT.Services]
AddService = ProconWinBus,%SPSVCINST_ASSOCSERVICE%, ProconWinBus_Service_Inst

[ProconWinBus_Service_Inst]
DisplayName    = %ProconWinBus.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\ProconWinBus.sys

[ProconWinBus_Device.NT.Wdf]
KmdfService = ProconWinBus, ProconWinBus_wdfsect

[ProconWinBus_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "proconwin"
DiskName = "proconwin Installation Disk"
ProconWinBus.DeviceDesc = "proconwin Virtual Gamepad Bus"
ProconWinBus.SVCDESC = "proconwin Virtual Gamepad Bus Service"
